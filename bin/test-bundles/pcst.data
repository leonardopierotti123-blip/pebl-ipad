      "options": [
        0,
        1
      ]
    },
    {
      "name": "useRandom",
      "type": "boolean",
      "default": 0,
      "description": "Whether to use random stimuli when possible for better retestability",
      "options": [
        0,
        1
      ]
    }
  ]
